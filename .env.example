# Copy this file to .env (untracked - see .gitignore) and fill in real
# values before running `docker compose up`. docker-compose automatically
# reads a .env file in this same directory and substitutes ${VAR} references
# in docker-compose.yml with it - nothing else needs to change.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root

# --- Session tokens (account-service issues them, transaction-service only
# verifies them - both MUST be set to the exact same value) ---
# Generate one with: openssl rand -hex 32
APP_JWT_SECRET=change-this-to-a-long-random-secret-before-any-real-deployment

# --- Razorpay (payment-service) ---
# https://dashboard.razorpay.com/app/keys - use the Test Mode keys, which
# start with rzp_test_, so no real money moves while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Twilio (notification-service) - optional ---
# Leave all three blank to keep the old behavior: OTP codes are only logged
# server-side (see notification-service's own logs), never sent as a real
# SMS. Fill them in to actually deliver the OTP to a phone.
#
# Where to get these, in the Twilio console at https://console.twilio.com:
#   TWILIO_ACCOUNT_SID   - shown on the console dashboard homepage
#   TWILIO_AUTH_TOKEN    - also on the dashboard homepage, next to the SID
#                          (click "view" to reveal it)
#   TWILIO_FROM_NUMBER   - Phone Numbers -> Manage -> Active Numbers, in
#                          E.164 format e.g. +15017122661. A trial account's
#                          free trial number works fine for this.
# A trial account can only text numbers you've verified under
# Phone Numbers -> Manage -> Verified Caller IDs - verify your own test
# phone there first, or Twilio will silently fail to deliver.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Country code prepended to a stored phone number when it doesn't already
# start with "+" (accounts in this system store plain 10-digit numbers).
SMS_DEFAULT_COUNTRY_CODE=+91
